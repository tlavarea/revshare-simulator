<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.revshare</groupId>
    <artifactId>revshare-simulator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>reporting-service</artifactId>
  <name>reporting-service</name>
  <description>
    The read side. Consumes the domain event stream and maintains a denormalized agent
    dashboard in MongoDB: cap progress, production, revenue share earnings, and the
    tier-grouped downline. Owns the Mongo read model; holds no business rules.
  </description>

  <dependencies>
    <!--
      For the event types only. The read side deserialises the very records the write side
      published, which is what makes the sealed DomainEvent hierarchy an exhaustive switch
      here rather than a chain of string comparisons. It uses none of the calculators.
    -->
    <dependency>
      <groupId>com.revshare</groupId>
      <artifactId>domain-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Deserialises the ISO-8601 dates in event payloads. -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mongodb</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The `exec` classifier is required, not cosmetic; see commission-service/pom.xml for
        the full account. In short: `repackage` is bound to `package`, which runs before
        `failsafe:integration-test`, and without a classifier it rewrites this module's jar
        in place into a fat jar that Failsafe then cannot discover tests from.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
